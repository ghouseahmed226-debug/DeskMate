# ============================================================
# DeskMate AI Environment Configuration (.env.example)
# Copy to .env and fill in values for your environment.
# NEVER commit real secrets or .env files to version control.
# ============================================================

# Application Environment: development | test | production
APP_ENV=development
APP_NAME=DeskMate AI
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000

# Security Keys (REQUIRED in production; dev uses ephemeral runtime keys if unset)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-secret-key-min-32-chars
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-base64-key-44-chars=
JWT_EXPIRE_MINUTES=120
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & Caching
# Local dev default uses SQLite; production uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg://deskmate:replace-password@localhost:5432/deskmate
DATABASE_URL=sqlite:///./deskmate.db
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=database

# LLM Provider Configuration: offline | gemini | openai | anthropic
# "offline" runs full DeskMate NLP + routing with zero paid API keys.
LLM_PROVIDER=offline
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# Optional Google ADK & MCP Modes
DESKMATE_USE_ADK=false
MCP_TRANSPORT=stdio

# Security & Rate Limits
RATE_LIMIT_PER_MIN=60
ANOMALY_TIME_WINDOW_SEC=60
ANOMALY_MAX_CALLS_PER_MIN=10
ANOMALY_MAX_CONSECUTIVE_WRITES=3
DEFAULT_TIMEZONE=UTC

# Optional Google OAuth (Gmail, Calendar, Contacts, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Optional External Integration Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Frontend URL Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
